generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ACCOUNTANT
  EMPLOYEE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  CHECK
  TRANSFER
  CARD
  OTHER
}

enum TransactionStatus {
  COMPLETED
  VOIDED
  PENDING
}

model User {
  id             String          @id @default(cuid())
  username       String          @unique
  name           String
  passwordHash   String
  role           Role            @default(ADMIN)
  active         Boolean         @default(true)
  transactions   Transaction[]
  moneyTransfers MoneyTransfer[]
  auditLogs      AuditLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Client {
  id             String          @id @default(cuid())
  name           String
  firstName      String
  lastName       String
  phone          String          @unique
  address        String          @db.Text
  identification String?
  idExpirationDate DateTime? @db.Date
  documentPath   String?         @db.Text
  documentName   String?         @db.Text
  active         Boolean         @default(true)
  transactions   Transaction[]
  moneyTransfers MoneyTransfer[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([name])
  @@index([active, idExpirationDate])
}

model Category {
  id           String           @id @default(cuid())
  name         String           @unique
  type         TransactionType?
  active       Boolean          @default(true)
  transactions Transaction[]
  createdAt    DateTime         @default(now())
}

model Transaction {
  id                 String            @id @default(cuid())
  date               DateTime
  type               TransactionType
  paymentMethod      PaymentMethod
  status             TransactionStatus @default(COMPLETED)
  amount             Decimal           @db.Decimal(12, 2)
  accountingExcluded Boolean           @default(false)
  currency           String            @default("USD")
  provider           String?
  referenceNumber    String?
  description        String?           @db.Text
  beneficiary        String?
  beneficiaryPhone   String?
  destinationStreet  String?
  destinationCity    String?
  receiptPath        String?           @db.Text
  receiptName        String?           @db.Text
  clientId           String?
  categoryId         String
  createdById        String
  client             Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  category           Category          @relation(fields: [categoryId], references: [id])
  createdBy          User              @relation(fields: [createdById], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([date])
  @@index([provider])
  @@index([clientId])
  @@index([type, date])
}

model MoneyTransfer {
  id                 String            @id @default(cuid())
  date               DateTime
  amount             Decimal           @db.Decimal(14, 2)
  commission         Decimal           @default(0) @db.Decimal(12, 2)
  currency           String            @default("USD")
  company            String
  bank               String?
  destinationCountry String?
  beneficiary        String?
  referenceNumber    String?
  status             TransactionStatus @default(COMPLETED)
  receiptPath        String?           @db.Text
  receiptName        String?           @db.Text
  clientId           String
  createdById        String
  client             Client            @relation(fields: [clientId], references: [id])
  createdBy          User              @relation(fields: [createdById], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([date])
  @@index([clientId, date])
  @@index([company, date])
  @@index([bank])
  @@index([currency])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model StoredFile {
  id        String      @id @default(cuid())
  name      String      @db.Text
  mimeType  String
  size      Int
  sha256    String      @db.Char(64)
  createdAt DateTime    @default(now())
  chunks    FileChunk[]
}

model FileChunk {
  fileId   String
  position Int
  data     Bytes      @db.MediumBlob
  file     StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([fileId, position])
}
